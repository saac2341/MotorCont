          <widget class="QRadioButton" name="radioButton">
           <property name="font">
            <font>
             <family>Bahnschrift</family>
             <pointsize>-1</pointsize>
            </font>
           </property>
           <property name="styleSheet">
            <string notr="true">/* Estado base del texto y contenedor */
QRadioButton {
    color: #e5e7eb;
    font-size: 14px;
    spacing: 6px; /* Espacio entre el círculo y el texto */
}

/* Tamaño del indicador (el círculo) */
QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border-radius: 7px; /* Mitad del ancho/alto + borde para que sea circular */
    border: 2px solid #6b7280;
    background-color: #1f2937;
}

/* Hover sobre el círculo cuando NO está seleccionado */
QRadioButton::indicator:unchecked:hover {
    border-color: #38bdf8;
}

/* Estado SELECCIONADO (Checked) */
QRadioButton::indicator:checked {
    border-color: #38bdf8;
    background-color: #38bdf8;
    /* En QSS puro creamos el punto central con una imagen o con márgenes/relleno */
}</string>
           </property>
           <property name="text">
            <string>Pasa bajas</string>
           </property>
          </widget>
