           <property name="styleSheet">
            <string notr="true">/* Estado Normal */
QPushButton {
    background-color: rgba(191, 64, 64, 0);
    color: #ffffff;
    border: 1px solid rgb(255, 120, 0);
    border-radius: 6px;
    padding: 2px 12px;
}

/* Al pasar el cursor por encima (Hover) */
QPushButton:hover {
    background-color: #2563eb;
}

/* Al presionar/hacer click (Pressed) */
QPushButton:pressed {
    background-color: rgb(0, 255, 0);
}

/* Estado Deshabilitado (Disabled) */
QPushButton:disabled {
    background-color: #9ca3af;
    color: #e5e7eb;
}</string>
           </property>
